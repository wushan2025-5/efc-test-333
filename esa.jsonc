{
  "name": "vite-react-template",
  "installCommand": "npm install",
  "entry": "/index.js",
  "assets": {
    "directory": "/src/assets",
    "notFoundStrategy": "singlePageApplication"
  },
"edgeFunctionFirst": ["/edge/", "/promo/"],
"regionFunction": {
    // 函数规格，基础版固定为 1c2g
    "instanceType": "1C2G",
    // 每个部署区域的最小实例数
    "minInstances": 1,
    // 单实例可同时执行的请求数
    "concurrency": 200,
    "timeout": 600,
  "idleTimeout": 600
  }

}
